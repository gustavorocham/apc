var pontos = 0; 


var plat1 = createSprite(100, 300);
plat1.setAnimation("platform"); 
plat1.velocityY = 1;

var plat2 = createSprite(300, 100);
plat2.setAnimation("platform");
plat2.velocityY = 1;

var jogador = createSprite(200, 200);
jogador.setAnimation("alien"); //


function draw() {
  
  cenario(); 
  
  
  exibirPlacar();
  
  
  movimentarJogador();
  loopPlataformas();
  
  
  drawSprites();
}



function cenario() {
  background("blue"); 
  
  
  fill("yellow");
  ellipse(350, 50, 60, 60); 
  
  
  fill("green");
  rect(0, 380, 400, 20);
}

function exibirPlacar() {
  fill("white");
  textSize(20);
  text("Pontos: " + pontos, 15, 30); //
}

function movimentarJogador() {
  
  jogador.velocityY = jogador.velocityY + 0.1;
  
  
  if (keyDown("left")) {
  jogador.x = jogador.x - 5;
  jogador.mirrorX(-1); // <--- Mude para -1 aqui
}

if (keyDown("right")) {
  jogador.x = jogador.x + 5;
  jogador.mirrorX(1);  // <--- Aqui fica 1

    
  }
  if (keyDown("up")) {
    jogador.velocityY = -5;
  }
  
  
  jogador.collide(plat1);
  jogador.collide(plat2);
}

function loopPlataformas() {
  if (plat1.y > 400) {
    plat1.y = 0;
    plat1.x = randomNumber(50, 350);
    pontos = pontos + 1; // <--- Adicione isso aqui
  }
  
  if (plat2.y > 400) {
    plat2.y = 0;
    plat2.x = randomNumber(50, 350);
    pontos = pontos + 1; // <--- E aqui também
  }
}
